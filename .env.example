# Copy to .env for local runs. On Fly, set these as secrets
# (fly secrets set KEY=value) instead of committing them.
# Never put real secrets in this file.

# Port the pairing page + health endpoint listen on (Fly sets 8080).
PORT=3000

# Gate the browser pairing page: visitors must enter this key before a
# code is issued. Leave unset only while you are pairing, then set it.
WEB_PAIR_KEY=

# Set to false to disable the browser pairing page entirely.
WEB_PAIR_ENABLED=true

# Port and host for the pairing page (WEB_PAIR_PORT falls back to PORT).
WEB_PAIR_PORT=3000
WEB_PAIR_HOST=0.0.0.0

# Key for the owner-only pairing report at /pair/api/stats.
# Falls back to WEB_PAIR_KEY when unset; the endpoint 404s when neither is set.
PAIR_STATS_KEY=

# Set to false to keep pairing history locally without WhatsApp notes.
PAIR_ALERTS=true

# Public base URL for the bot's own brand art (menu/thumbnail images).
# On Fly this is derived from FLY_APP_NAME when unset.
PUBLIC_URL=

# Where the WhatsApp session and JSON database live on disk.
# Fly sets DATA_DIR=/data (the mounted volume); SESSION_DIR defaults to ./session.
DATA_DIR=
SESSION_DIR=

# Set to true to log group-admin checks (who counts as admin, and why).
DEBUG_GROUP_ADMIN=false
